generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

// ============================
// ENUMS
// ============================

enum UserRole {
CUSTOMER
ADMIN
}

enum BrandStatus {
ACTIVE
INACTIVE
}

enum AccountStatus {
PENDING_VERIFICATION
ACTIVE
}

enum VerificationTokenType {
EMAIL_VERIFICATION
PASSWORD_RESET
}

enum SupplierStatus {
ACTIVE
INACTIVE
}

enum OrderStatus {
CREATED
PENDING_PAYMENT
PAID
PROCESSING
SHIPPED
DELIVERED
COMPLETED
CANCELLED
}

enum ShipmentStatus {
PENDING
BOOKED
PICKING_UP
IN_TRANSIT
OUT_FOR_DELIVERY
DELIVERED
CANCELLED
FAILED
}

enum NotificationType {
ACCOUNT
ORDER
PAYMENT
}

enum MembershipStatus {
NON_MEMBER
MEMBER
}

enum PaymentMethod {
QRIS
VIRTUAL_ACCOUNT
MANUAL_BANK_TRANSFER
}

enum PaymentProvider {
MIDTRANS
}

enum PaymentStatus {
PENDING
PROCESSING
PAID
FAILED
EXPIRED
}

enum PaymentAttemptStatus {
PENDING
PROCESSING
PAID
FAILED
EXPIRED
}

enum PaymentSubmissionStatus {
PENDING_REVIEW
APPROVED
REJECTED
}

enum StockMovementType {
IN
OUT
ADJUSTMENT
RESERVATION
RELEASE
COMMIT
}

enum StockReservationStatus {
RESERVED
RELEASED
COMMITTED
}

enum IdempotencyStatus {
PROCESSING
COMPLETED
FAILED
}

// ============================
// USER / AUTHENTICATION
// ============================

model User {
id String @id @default(uuid()) @db.Uuid
fullName String @map("full_name") @db.VarChar(100)
email String @unique @db.VarChar(255)
passwordHash String @map("password_hash")
role UserRole @default(CUSTOMER)
accountStatus AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
profilePhotoUrl String? @map("profile_photo_url")
profilePhotoPublicId String? @map("profile_photo_public_id")

membershipStatus MembershipStatus @default(NON_MEMBER) @map("membership_status")
membershipActivatedAt DateTime? @map("membership_activated_at") @db.Timestamptz(6)

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

verificationTokens VerificationToken[]
sessions Session[]
customerAddresses CustomerAddress[]
productReviews ProductReview[]
wishlistItems WishlistItem[]
carts Cart[]
orders Order[]
notifications Notification[]
stockMovements StockMovement[] @relation("StockMovementCreatedBy")
idempotencyRecords IdempotencyRecord[]

orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")

paymentSubmissionsVerified PaymentSubmission[] @relation("PaymentSubmissionVerifiedBy")

@@index([role], map: "idx_users_role")
@@index([accountStatus], map: "idx_users_account_status")
@@index([deletedAt], map: "idx_users_deleted_at")
@@map("users")
}

model CustomerAddress {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
label String @db.VarChar(50)
recipientName String @map("recipient_name") @db.VarChar(100)
phone String @db.VarChar(30)
addressLine String @map("address_line") @db.Text
district String @db.VarChar(100)
city String @db.VarChar(100)
province String @db.VarChar(100)
postalCode String @map("postal_code") @db.VarChar(10)
isDefault Boolean @default(false) @map("is_default")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_customer_addresses_user_id")
@@index([userId, isDefault], map: "idx_customer_addresses_user_default")
@@map("customer_addresses")
}

model VerificationToken {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
tokenLookup String @unique @map("token_lookup")
tokenHash String @unique @map("token_hash")
type VerificationTokenType @default(EMAIL_VERIFICATION)
expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
usedAt DateTime? @map("used_at") @db.Timestamptz(6)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_verification_tokens_user_id")
@@index([type], map: "idx_verification_tokens_type")
@@index([expiresAt], map: "idx_verification_tokens_expires_at")
@@map("verification_tokens")
}

model Session {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
tokenLookup String @unique @map("token_lookup")
tokenHash String @unique @map("token_hash")
expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_sessions_user_id")
@@index([expiresAt], map: "idx_sessions_expires_at")
@@index([revokedAt], map: "idx_sessions_revoked_at")
@@map("sessions")
}

// ============================
// PRODUCT CATALOG
// ============================

model Brand {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @db.VarChar(100)
  slug              String      @unique @db.VarChar(120)
  tagline           String?     @db.VarChar(200)
  description       String?     @db.Text
  origin            String?     @db.VarChar(150)
  logoUrl           String?     @map("logo_url")
  logoPublicId      String?     @map("logo_public_id")
  coverImageUrl     String?     @map("cover_image_url")
  coverImagePublicId String?    @map("cover_image_public_id")
  featured          Boolean     @default(false)
  status            BrandStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([name], map: "idx_brands_name")
  @@index([status], map: "idx_brands_status")
  @@index([featured], map: "idx_brands_featured")
  @@map("brands")
}

model Supplier {
id String @id @default(uuid()) @db.Uuid
name String @db.VarChar(100)
slug String @unique @db.VarChar(120)
status SupplierStatus @default(ACTIVE)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

products Product[]

@@index([name], map: "idx_suppliers_name")
@@index([status], map: "idx_suppliers_status")
@@map("suppliers")
}

model Category {
id String @id @default(uuid()) @db.Uuid
name String @db.VarChar(100)
slug String @unique @db.VarChar(120)
parentId String? @map("parent_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
children Category[] @relation("CategoryHierarchy")
products Product[]

@@index([parentId], map: "idx_categories_parent_id")
@@index([name], map: "idx_categories_name")
@@map("categories")
}

model Product {
id String @id @default(uuid()) @db.Uuid
sku String @unique @db.VarChar(100)
name String @db.VarChar(150)
slug String @unique @db.VarChar(180)
description String? @db.Text
price Int

newUntil DateTime? @map("new_until")
weightGram Int? @map("weight_gram")
lengthCm Float? @map("length_cm")
widthCm Float? @map("width_cm")
heightCm Float? @map("height_cm")

brandId String @map("brand_id") @db.Uuid
supplierId String @map("supplier_id") @db.Uuid
categoryId String @map("category_id") @db.Uuid

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

brand Brand @relation(fields: [brandId], references: [id])
supplier Supplier @relation(fields: [supplierId], references: [id])
category Category @relation(fields: [categoryId], references: [id])

media ProductMedia[]
reviews ProductReview[]
wishlistItems WishlistItem[]
cartItems CartItem[]
orderItems OrderItem[]
inventory Inventory?
stockReservations StockReservation[]

@@index([brandId], map: "idx_products_brand_id")
@@index([supplierId], map: "idx_products_supplier_id")
@@index([categoryId], map: "idx_products_category_id")
@@index([name], map: "idx_products_name")
@@map("products")
}

model ProductMedia {
id String @id @default(uuid()) @db.Uuid
productId String @map("product_id") @db.Uuid
url String
publicId String @map("public_id")
sortOrder Int @default(0) @map("sort_order")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

product Product @relation(fields: [productId], references: [id])

@@index([productId], map: "idx_product_media_product_id")
@@index([productId, sortOrder], map: "idx_product_media_product_sort")
@@map("product_media")
}

model ProductReview {
id String @id @default(uuid()) @db.Uuid
productId String @map("product_id") @db.Uuid
userId String @map("user_id") @db.Uuid
rating Int
reviewText String? @map("review_text") @db.Text
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

product Product @relation(fields: [productId], references: [id])
user User @relation(fields: [userId], references: [id])

@@index([productId], map: "idx_product_reviews_product_id")
@@index([userId], map: "idx_product_reviews_user_id")
@@index([productId, createdAt], map: "idx_product_reviews_product_created")
@@map("product_reviews")
}

model WishlistItem {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
productId String @map("product_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])
product Product @relation(fields: [productId], references: [id])

@@unique([userId, productId], map: "uq_wishlist_items_user_product")
@@index([userId], map: "idx_wishlist_items_user_id")
@@index([productId], map: "idx_wishlist_items_product_id")
@@map("wishlist_items")
}

// ============================
// SHOPPING CART
// ============================

model Cart {
id String @id @default(uuid()) @db.Uuid
userId String @unique @map("user_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])
items CartItem[]

@@map("carts")
}

model CartItem {
id String @id @default(uuid()) @db.Uuid
cartId String @map("cart_id") @db.Uuid
productId String @map("product_id") @db.Uuid
quantity Int
isSelected Boolean @default(true) @map("is_selected")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

cart Cart @relation(fields: [cartId], references: [id])
product Product @relation(fields: [productId], references: [id])

@@unique([cartId, productId], map: "uq_cart_items_cart_product")
@@index([cartId], map: "idx_cart_items_cart_id")
@@index([productId], map: "idx_cart_items_product_id")
@@map("cart_items")
}

// ============================
// INVENTORY
// ============================

model Inventory {
id String @id @default(uuid()) @db.Uuid
productId String @unique @map("product_id") @db.Uuid
availableQuantity Int @default(0) @map("available_quantity")
reservedQuantity Int @default(0) @map("reserved_quantity")
committedQuantity Int @default(0) @map("committed_quantity")
lowStockThreshold Int @default(0) @map("low_stock_threshold")
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

product Product @relation(fields: [productId], references: [id])
stockMovements StockMovement[]

@@map("inventories")
}

model StockMovement {
id String @id @default(uuid()) @db.Uuid
inventoryId String @map("inventory_id") @db.Uuid
type StockMovementType
quantity Int
referenceType String @map("reference_type") @db.VarChar(50)
referenceId String? @map("reference_id") @db.Uuid
reason String? @db.Text
createdByUserId String? @map("created_by_user_id") @db.Uuid
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

inventory Inventory @relation(fields: [inventoryId], references: [id])

createdByUser User? @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])

@@index([inventoryId], map: "idx_stock_movements_inventory_id")
@@index([type], map: "idx_stock_movements_type")
@@index([referenceType, referenceId], map: "idx_stock_movements_reference")
@@index([createdByUserId], map: "idx_stock_movements_created_by")
@@index([createdAt], map: "idx_stock_movements_created_at")
@@map("stock_movements")
}

// ============================
// ORDERS
// ============================

model Order {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
orderNumber String @unique @map("order_number") @db.VarChar(30)
status OrderStatus @default(CREATED)

subtotalAmount Int @default(0) @map("subtotal_amount")
discountAmount Int @default(0) @map("discount_amount")
shippingAmount Int @default(0) @map("shipping_amount")
totalAmount Int @map("total_amount")

shippingProvider String? @map("shipping_provider") @db.VarChar(50)
shippingCourierCode String? @map("shipping_courier_code") @db.VarChar(50)
shippingCourierName String? @map("shipping_courier_name") @db.VarChar(100)
shippingServiceCode String? @map("shipping_service_code") @db.VarChar(50)
shippingServiceName String? @map("shipping_service_name") @db.VarChar(100)

shippingRecipientName String @map("shipping_recipient_name") @db.VarChar(100)
shippingPhone String @map("shipping_phone") @db.VarChar(30)
shippingAddressLine String @map("shipping_address_line") @db.Text
shippingDistrict String @map("shipping_district") @db.VarChar(100)
shippingCity String @map("shipping_city") @db.VarChar(100)
shippingProvince String @map("shipping_province") @db.VarChar(100)
shippingPostalCode String @map("shipping_postal_code") @db.VarChar(10)

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

items OrderItem[]

statusHistory OrderStatusHistory[]

payment Payment?

stockReservations StockReservation[]

shipment Shipment?

idempotencyRecords IdempotencyRecord[]

@@index([userId], map: "idx_orders_user_id")
@@index([userId, createdAt], map: "idx_orders_user_created")
@@index([status], map: "idx_orders_status")
@@map("orders")
}

model OrderItem {
id String @id @default(uuid()) @db.Uuid
orderId String @map("order_id") @db.Uuid
productId String @map("product_id") @db.Uuid
productName String @map("product_name") @db.VarChar(150)
sku String @db.VarChar(100)
unitPrice Int @map("unit_price")
quantity Int
subtotal Int

order Order @relation(fields: [orderId], references: [id])
product Product @relation(fields: [productId], references: [id])

@@index([orderId], map: "idx_order_items_order_id")
@@index([productId], map: "idx_order_items_product_id")
@@map("order_items")
}

model OrderStatusHistory {
id String @id @default(uuid()) @db.Uuid
orderId String @map("order_id") @db.Uuid
fromStatus OrderStatus? @map("from_status")
toStatus OrderStatus @map("to_status")
changedByUserId String? @map("changed_by_user_id") @db.Uuid
reason String? @db.Text
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

order Order @relation(fields: [orderId], references: [id])

changedByUser User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id])

@@index([orderId], map: "idx_order_status_history_order_id")
@@index([orderId, createdAt], map: "idx_order_status_history_order_created")
@@index([changedByUserId], map: "idx_order_status_history_changed_by")
@@map("order_status_histories")
}

model StockReservation {
id String @id @default(uuid()) @db.Uuid
productId String @map("product_id") @db.Uuid
orderId String @map("order_id") @db.Uuid
quantity Int
status StockReservationStatus
expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
committedAt DateTime? @map("committed_at") @db.Timestamptz(6)

product Product @relation(fields: [productId], references: [id])
order Order @relation(fields: [orderId], references: [id])

@@index([orderId], map: "idx_stock_reservations_order_id")
@@index([productId], map: "idx_stock_reservations_product_id")
@@index([status], map: "idx_stock_reservations_status")
@@index([expiresAt], map: "idx_stock_reservations_expires_at")
@@map("stock_reservations")
}

// ============================
// PAYMENT
// ============================

model Payment {
id String @id @default(uuid()) @db.Uuid
orderId String @unique @map("order_id") @db.Uuid
method PaymentMethod
status PaymentStatus @default(PENDING)
amount Int
provider PaymentProvider?
providerTransactionId String? @unique @map("provider_transaction_id") @db.VarChar(150)

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
expiredAt DateTime? @map("expired_at") @db.Timestamptz(6)
paidAt DateTime? @map("paid_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

order Order @relation(fields: [orderId], references: [id])
attempts PaymentAttempt[]
submissions PaymentSubmission[]

@@index([status], map: "idx_payments_status")
@@index([createdAt], map: "idx_payments_created_at")
@@index([expiresAt], map: "idx_payments_expires_at")
@@map("payments")
}

model PaymentAttempt {
id String @id @default(uuid()) @db.Uuid
paymentId String @map("payment_id") @db.Uuid
attemptNumber Int @map("attempt_number")
providerReference String? @map("provider_reference") @db.VarChar(150)
status PaymentAttemptStatus @default(PENDING)
requestPayload Json? @map("request_payload")
responsePayload Json? @map("response_payload")
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

payment Payment @relation(fields: [paymentId], references: [id])

@@unique([paymentId, attemptNumber], map: "uq_payment_attempts_payment_number")
@@index([paymentId], map: "idx_payment_attempts_payment_id")
@@index([status], map: "idx_payment_attempts_status")
@@index([providerReference], map: "idx_payment_attempts_provider_reference")
@@map("payment_attempts")
}

model PaymentSubmission {
id String @id @default(uuid()) @db.Uuid
paymentId String @map("payment_id") @db.Uuid
senderBank String @map("sender_bank") @db.VarChar(100)
senderName String @map("sender_name") @db.VarChar(100)
transferAmount Int @map("transfer_amount")
transferredAt DateTime @map("transferred_at") @db.Timestamptz(6)
proofUrl String @map("proof_url")
ocrData Json? @map("ocr_data")
submittedData Json? @map("submitted_data")
status PaymentSubmissionStatus @default(PENDING_REVIEW)
rejectionReason String? @map("rejection_reason") @db.Text
verifiedByUserId String? @map("verified_by_user_id") @db.Uuid
verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

payment Payment @relation(fields: [paymentId], references: [id])
verifiedBy User? @relation("PaymentSubmissionVerifiedBy", fields: [verifiedByUserId], references: [id])

@@index([paymentId], map: "idx_payment_submissions_payment_id")
@@index([status], map: "idx_payment_submissions_status")
@@index([createdAt], map: "idx_payment_submissions_created_at")
@@index([verifiedByUserId], map: "idx_payment_submissions_verified_by")
@@map("payment_submissions")
}

// ============================
// IDEMPOTENCY
// ============================

model IdempotencyRecord {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
key String @db.VarChar(255)
operation String @db.VarChar(100)
requestHash String @map("request_hash") @db.VarChar(128)
status IdempotencyStatus @default(PROCESSING)

orderId String? @unique @map("order_id") @db.Uuid
responsePayload Json?

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])
order Order? @relation(fields: [orderId], references: [id])

@@unique([userId, key], map: "uq_idempotency_records_user_key")
@@index([userId], map: "idx_idempotency_records_user_id")
@@index([status], map: "idx_idempotency_records_status")
@@index([expiresAt], map: "idx_idempotency_records_expires_at")
@@map("idempotency_records")
}

// ============================
// SHIPMENT
// ============================

model Shipment {
id String @id @default(uuid()) @db.Uuid

orderId String @unique @map("order_id") @db.Uuid

provider String @db.VarChar(50)
externalOrderId String? @map("external_order_id") @db.VarChar(100)

courierCode String? @map("courier_code") @db.VarChar(50)
courierName String? @map("courier_name") @db.VarChar(100)

serviceCode String? @map("service_code") @db.VarChar(50)
serviceName String? @map("service_name") @db.VarChar(100)

trackingNumber String? @map("tracking_number") @db.VarChar(100)

shippingCost Int @map("shipping_cost")
status ShipmentStatus @default(PENDING)

labelUrl String? @map("label_url")

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

order Order @relation(fields: [orderId], references: [id])

@@index([status], map: "idx_shipments_status")
@@index([trackingNumber], map: "idx_shipments_tracking_number")
@@map("shipments")
}

// ============================
// NOTIFICATION
// ============================

model Notification {
id String @id @default(uuid()) @db.Uuid
userId String @map("user_id") @db.Uuid
type NotificationType
title String @db.VarChar(150)
message String @db.Text
isRead Boolean @default(false) @map("is_read")

createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

user User @relation(fields: [userId], references: [id])

@@index([userId], map: "idx_notifications_user_id")
@@index([userId, createdAt], map: "idx_notifications_user_created")
@@index([userId, isRead], map: "idx_notifications_user_read")
@@map("notifications")
}
